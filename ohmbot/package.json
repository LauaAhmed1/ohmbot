{
  "name": "ohmbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quellenbasierter Studierenden-Chatbot für ein IT-Projekt an der TH Nürnberg",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
